{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "title":"AuthMatrix result v1", "type":"object", "additionalProperties":false,
 "required":["schema","input_sha256","scope_sha256","evidence_status","summary","evidence"],
 "properties":{
  "schema":{"const":"authmatrix.result/v1"},
  "input_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
  "scope_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
  "evidence_status":{"const":"observed"},
  "summary":{"type":"object","additionalProperties":false,"required":["match","potential_bypass","inconclusive"],"properties":{"match":{"type":"integer","minimum":0},"potential_bypass":{"type":"integer","minimum":0},"inconclusive":{"type":"integer","minimum":0}}},
  "evidence":{"type":"array","minItems":1,"maxItems":1000,"items":{"type":"object","additionalProperties":false,"required":["case_sha256","kind","expected","observed_status","verdict","confidence"],"properties":{
    "case_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"kind":{"enum":["horizontal","vertical","unauthenticated"]},"expected":{"enum":["allow","deny"]},"observed_status":{"type":"integer","minimum":100,"maximum":599},"verdict":{"enum":["match","potential-bypass","inconclusive"]},"confidence":{"const":"observation-only"}
  }}}
 }
}
